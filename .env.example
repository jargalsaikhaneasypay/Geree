# DB password (postgres container uses this)
DB_PASSWORD=geree_pass_2026

# Super admin email (users page-г зөвхөн энэ хэрэглэгч удирдана)
SUPER_ADMIN=admin@easypay.mn

# Secret key for Flask sessions — change to a long random string
SECRET_KEY=change-this-to-a-long-random-secret

# Leave DATABASE_URL empty — docker-compose sets it automatically from DB_PASSWORD above
# DATABASE_URL=postgresql://geree_user:geree_pass_2026@db:5432/geree_db

# Oracle DB connection (for /test-oracle page)
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_DSN=192.168.1.10:1521/ORCL
